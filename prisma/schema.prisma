// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  title        String
  displayTitle String?
  eventDate    DateTime
  location     String       @default("")
  mapsLink     String?
  coords       String?
  posterUrl    String?
  ticketLink   String?
  racoLink     String?
  description  String?      @db.Text
  isPublished  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lineup       LineupItem[]

  @@index([eventDate])
  @@index([slug])
}

model Resident {
  id                  Int          @id @default(autoincrement())
  slug                String       @unique
  name                String
  bio                 String?      @db.Text
  photo               String?
  photoFull           String?
  videoUrl            String?
  instagramUrl        String?
  soundcloudUrl       String?
  raUrl               String?
  soundcloudWidgetUrl String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lineup              LineupItem[]

  @@index([slug])
}

model LineupItem {
  id           Int       @id @default(autoincrement())
  eventId      Int
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  residentId   Int?
  resident     Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  residentSlug String?
  djName       String?
  djInstagram  String?
  sortOrder    Int       @default(0)

  @@index([eventId])
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String?  @db.Text
  timestamp DateTime @default(now())
}

model Analytics {
  id        Int      @id @default(autoincrement())
  page      String
  referrer  String?
  ipHash    String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([page])
}
